NEXT_PUBLIC_SUPABASE_URL=
# Public key (sb_publishable_...). Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY still works until Supabase retires it (end of 2026).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
# Where the Contact form is delivered (server-only, never shown on the site).
CONTACT_TO_EMAIL=

# Secret key (sb_secret_..., Settings > API Keys > Secret keys). Used ONLY by the local MCA import script.
# Do not add it to Vercel; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# data.gov.in key, used only by the one-time MCA import (npm run import:mca), never at request time.
DATA_GOV_IN_API_KEY=

# Optional Reddit check (OAuth app-only). Leave empty to skip; the report shows "unavailable".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
